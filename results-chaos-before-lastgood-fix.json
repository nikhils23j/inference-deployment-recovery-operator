   "rogue_writer": 1,
   "api_errors": 2,
   "watch_break": 1,
   "crash_leader": 1
  },
  "faults_per_schedule": "3-10 in t=[10,60] s, +12% chance of CR deletion at end",
  "watch_delay_max_choices_s": [
   0.005,
   0.1,
   0.5,
   2.0
  ],
  "watch_silent_drop_choices": [
   0.0,
   0.0,
   0.02,
   0.1
  ]
 },
 "definitions": {
  "converged": "from the end of the last fault, the API objects reach and STAY in the healthy state until the end of the run: owned Deployment+Service match spec, fake Deployment controller reports it available, image == spec.image (or, if spec.image is broken, a non-broken image), and for v2 variants status.observedGeneration == generation with the right Ready/Degraded condition. If the schedule deletes the CR: CR and all owned objects gone.",
  "convergence_s": "simulated seconds from the end of the last fault window to stable convergence",
  "convergence_reconciles": "reconcile calls (all replicas) in that interval",
  "unhealthy_s": "total simulated seconds from t=10 s to the end of the run during which the healthy check failed (captures outages DURING fault windows, e.g. while a crashed v1 is down)",
  "invariants_ok": "no successful controller write to an object not controlled by this CR; no write by a non-Lease-holder (v2); <=1 owned object per kind at every instant; hand-made look-alike Deployment untouched; <= 50 controller requests in every 1 s bucket; zero controller writes in the last 30 s once converged"
 },
 "variants": {
  "none": "children applied once at t=0 (kubectl apply), no controller",
  "naive": "2 replicas, no leader election, no ownership check, blind patches, 10 ms retry, 0.5 s polling",
  "v1": "exact v1 reconcile (v1/controller_v1.py) polled every 0.5 s by one replica - the code measured on k3s",
  "v2": "2 replicas with Lease election, informer cache + watches, rate-limited queue, finalizer, status, rollback",
  "v2_no_lease": "ablation: v2 with both replicas active (relies only on resourceVersion conflicts)",
  "v2_no_refresh": "ablation: v2 without the targeted cache re-read after a 409 (the first version I wrote)"
 },
